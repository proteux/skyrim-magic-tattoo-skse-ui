      "param3": {
        "label": "Ramp up (ms)",
        "min": 1,
        "max": 2000,
        "default": 150,
        "step": 10
      },
      "param4": {
        "label": "Decay (ms)",
        "min": 1,
        "max": 5000,
        "default": 500,
        "step": 10
      },
      "param5": {
        "label": "Sustain window (ms)",
        "min": 0,
        "max": 2000,
        "default": 800,
        "step": 10
      }
    },
