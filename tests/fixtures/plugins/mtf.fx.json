        "label": "Trigger event",
        "menu": [
          {
            "id": "disabled",
            "label": "Disabled"
          },
          {
            "id": "blunt_only",
            "label": "Blunt only"
          },
          {
            "id": "bladed_only",
            "label": "Bladed only"
          },
          {
            "id": "ranged_only",
            "label": "Ranged only"
          },
          {
            "id": "fire_only",
            "label": "Fire only"
          },
          {
            "id": "frost_only",
            "label": "Frost only"
          },
          {
            "id": "shock_only",
            "label": "Shock only"
          },
          {
            "id": "melee_blunt_bladed",
            "label": "Melee (Blunt + Bladed)"
          },
          {
            "id": "physical_blunt_bladed_ranged",
            "label": "Physical (Blunt + Bladed + Ranged)"
          },
          {
            "id": "magic_fire_frost_shock",
            "label": "Magic (Fire + Frost + Shock)"
          },
          {
            "id": "all_combat_classes",
            "label": "All combat classes"
          },
          {
            "id": "on_spell_cast",
            "label": "On spell cast"
          }
        ],
        "default": "disabled"
      },
      "param2": {
        "label": "Peak emissive (additive, % of 1.0)",
        "min": 0,
        "max": 1000,
        "default": 300,
        "step": 10
